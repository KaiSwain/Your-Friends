# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-publishable-key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy Supabase anon keys are also supported.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Supabase Edge Function secrets
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_CAPTION_MODEL=gpt-4o-mini
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
TMDB_ACCESS_TOKEN=your-tmdb-api-read-access-token
# Legacy TMDb API keys are also supported by the movie search function.
TMDB_API_KEY=your-tmdb-api-key
APPLE_BUNDLE_ID=com.yourfriends.app
APPLE_IAP_ISSUER_ID=your-app-store-connect-issuer-id
APPLE_IAP_KEY_ID=your-app-store-connect-key-id
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----"

# App Store Connect subscription product IDs used by the app:
# yourfriends_premium_monthly ($4.99/month)
# yourfriends_premium_6_months ($19.99/6 months)
# yourfriends_premium_yearly ($29.99/year)